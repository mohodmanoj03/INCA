.head 3 +  Function: fDeleteMarkTableRow	! Uppdaterar tabellradens borttagsmarkering.
.head 4 -  Description: =====================================================
Syntax:		bOk = fDeleteMarkTableRow( hWndTbl, nCurrentRow )

Beskrivning: 	Uppdaterar tabellradens borttagsmarkering. Markeringen kan anta två
		värden, och växlar mellan dessa.

Parametrar:	hWndTbl		Window handle till tabellen.
		nCurrentRow	Radnr.

Returnerar:	bOk		True eller False
Ändringslogg
----------------------------------------------------------------------------------------------------------
Datum		Ändrat av		Beskrivning
----------------------------------------------------------------------------------------------------------
=====================================================
.head 4 +  Returns
.head 5 -  Boolean:
.head 4 +  Parameters
.head 5 -  Window Handle: hWndTbl
.head 5 -  Number: nCurrentRow
.head 4 -  Static Variables
.head 4 -  Local variables
.head 4 +  Actions
.head 5 -  ! ---------- Uppdaterar tabellradens borttagsmarkering
.head 5 +  If SalTblQueryRowFlags( hWndTbl, nCurrentRow, ROW_MarkDeleted ) = False
.head 6 -  Call SalTblSetRowFlags( hWndTbl, nCurrentRow, ROW_MarkDeleted, True )
.head 5 +  Else
.head 6 -  Call SalTblSetRowFlags( hWndTbl, nCurrentRow, ROW_MarkDeleted, False )
.head 5 -  !
.head 5 -  ! ---------- Uppdaterar sparaknappens status
.head 5 +  If SalTblAnyRows( hWndTbl, ROW_Edited | ROW_MarkDeleted | ROW_New, 0 )
.head 6 -  Call SalEnableWindow( pbSpara )
.head 6 -  Call SalPicSet( hWndForm.pbSpara, gIcoSpara, PIC_FormatIcon )
.head 6 -  Set hWndForm.bTableWindowEdited = True
.head 5 +  Else
.head 6 -  Call SalDisableWindow( pbSpara )
.head 6 -  Call SalPicSet( hWndForm.pbSpara, gIcoSparaTom, PIC_FormatIcon )
.head 6 -  Set hWndForm.bTableWindowEdited = False
.head 5 -  !
.head 5 -  Return True
.head 3 +  Function: fGetDataFromDb		! Read data from the database..
.head 4 -  Description: =====================================================
Syntax:		bOk = fGetDataFromDb(hWndForm)

Example:		Call fGetDataFromDb( hWndForm)

Description: 	Call an Oracle procedure.

Parameters:	-		No parameters used.

Returns:		bOk		True or False
=====================================================
.head 4 +  Returns
.head 5 -  Boolean:
.head 4 +  Parameters
.head 5 -  Window Handle: hWndTbl
.head 4 -  Static Variables
.head 4 +  Local variables
.head 5 -  Boolean: bOk
.head 5 -  Number: nRowcount_Out
.head 5 -  Number: nIndex
.head 5 -  Number: nRetcode
.head 5 -  Number: nRow
.head 5 -  Number: nWdmidno_In		!080305 Barbro
.head 5 -  Number: nLinkidno_Out[*]		!080307 Barbro
.head 5 -  Number: nSlidnr_Out[*]
.head 5 -  Number: nSortnrLink_Out[*]
.head 5 -  Number: nSortnrSegment_Out[*]
.head 5 -  String: sLink_Out[*]
.head 5 -  String: sSegment_Out[*]
.head 5 -  String: sSlid_Out[*]
.head 5 -  String: sOraPackage
.head 5 -  String: sOraProcedure
.head 5 -  String: sPlSqlString
.head 5 -  String: sQualifiedOraProcedure
.head 4 +  Actions
.head 5 -  Call SalWaitCursor( True )
.head 5 -  !
.head 5 -  !
.head 5 -  ! --------------- Initiate variables.
.head 5 -  Set bOk = True
.head 5 -  Call SalTblReset( hWndTbl )
.head 5 -  !
.head 5 -  Set nWdmidno_In = SalStrToNumber( sInParam[gnIndexWdmidno] )	!080306 Barbro
.head 5 -  !
.head 5 -  ! --------------- Database call.
.head 5 -  !
.head 5 -  Set sOraPackage = 'icp_wdm_utilization'
.head 5 -  ! Set sOraProcedure = 'wdm_segment_link_las'			!080305 Barbro
.head 5 -  Set sOraProcedure = 'wdm_segment_link_las_252'			!080305 Barbro
.head 5 -  Set sQualifiedOraProcedure = sOraPackage||'.'||sOraProcedure
.head 5 -  Set sPlSqlString = sQualifiedOraProcedure||'( '
.head 5 -  Set sPlSqlString = sPlSqlString || 'nWdmidno_In,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nLinkidno_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'sLink_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'sSegment_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nSortnrLink_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nSortnrSegment_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'sSlid_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nSlidnr_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nRowcount_Out,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nRetcode )'
.head 5 +  If SqlPLSQLCommand( hSqlOra1, sPlSqlString )
.head 6 +  If nRetcode = 0
.head 7 +  While nIndex < nRowcount_Out
.head 8 -  Set nRow = SalTblInsertRow( hWndTbl, TBL_MaxRow )
.head 8 -  Call SalTblSetContext( hWndTbl, nRow )
.head 8 -  !
.head 8 -  Set hWndTbl.colnLinkidno		= nLinkidno_Out[nIndex]
.head 8 -  Set hWndTbl.colsLink	 	= SalStrTrimX( sLink_Out[nIndex] )
.head 8 -  Set hWndTbl.colsSegment 		= SalStrTrimX( sSegment_Out[nIndex] )
.head 8 -  Set hWndTbl.colnSortnrlink		= nSortnrLink_Out[nIndex]
.head 8 -  Set hWndTbl.colnSortnrSegment	= nSortnrSegment_Out[nIndex]
.head 8 -  Set hWndTbl.colsSlid 		= SalStrTrimX( sSlid_Out [nIndex] )
.head 8 -  Set hWndTbl.colnSlidnr 		= nSlidnr_Out[nIndex]
.head 8 -  !
.head 8 -  Set nIndex = nIndex +1
.head 6 +  Else
.head 7 -  Call fVisaMeddelande( Msg_Fel_Ok, fGetMessageFromSqlretcode( sQualifiedOraProcedure, nRetcode ), nRetcode )
.head 7 -  Set bOk = False
.head 5 -  !
.head 5 -  Call SalSendMsgToChildren( hWndTbl, PAM_AutoSize, wParam, lParam )
.head 5 -  Call SalTblSetFlagsAnyRows( hWndTbl, ROW_New, False, 0, 0 )
.head 5 -  !
.head 5 -  Call SalWaitCursor( False )
.head 5 -  Return bOk
