.head 5 +  Select Case ( hWndForm.nUrvalsKombination )
.head 6 +  Case 1	! read ( Report )
.head 7 -  ! ----------Initiering av parametrar
.head 7 -  Set sOraPackage = 'icp_netanalysis'
.head 7 -  Set sOraProcedure = 'readReport'
.head 7 -  Set sQualifiedOraProcedure = sOraPackage||'.'||sOraProcedure
.head 7 -  !
.head 7 -  ! Set sUserIn	= SalStrTrimX( hWndForm.sUserUrval )
.head 7 -  ! Set sReportIn	= SalStrTrimX( hWndForm.sReportUrval )
.head 7 +  ! If hWndForm.bExceededLimitUrval = False
.head 8 -  Set nExceededLimitIn	= 0
.head 7 +  ! If hWndForm.bExceededLimitUrval = True
.head 8 -  Set nExceededLimitIn	= 1
.head 7 -  !
.head 7 -  Set sUserIn	= SalStrTrimX( PsUser )
.head 7 -  Set sReportIn	= SalStrTrimX( PsReport )
.head 7 +  If PbExceededLimit = False
.head 8 -  Set nExceededLimitIn	= 0
.head 7 +  If PbExceededLimit = True
.head 8 -  Set nExceededLimitIn	= 1
.head 7 -  !
.head 7 -  Set sPlSqlString = sQualifiedOraProcedure||'( '
.head 7 -  Set sPlSqlString = sPlSqlString || 'sUserIn,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'sReportIn,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nExceededLimitIn,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'sUseridUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nReportnrUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'sReportNameUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nAnalysidnrUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nAnodnrUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nBnodnrUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'sLinkUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nLimitUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nContentprocUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nTotalUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nContentUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nFreeUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nPlannedplusUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nPlannedminusUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nReservedplusUt,'
.head 7 -  ! Set sPlSqlString = sPlSqlString || 'nReservedminusUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nRowcountUt,'
.head 7 -  Set sPlSqlString = sPlSqlString || 'nRetcode )'
.head 7 -  !
.head 7 -  Set nIndex = 0
.head 7 +  If SqlPLSQLCommand( hSqlOra1, sPlSqlString )
.head 8 +  If GbStoreSql
.head 9 -  Call SalDateToStr( SalDateCurrent(), sTemp1 )
.head 9 -  Set gsSqlSave[5] = SalStrMidX( sTemp1, 11, 8 )
.head 9 -  ! Set gsSqlSave[6] = SalNumberToStrX( nFelkod, 0 )
.head 9 -  Set gsSqlSave[7] = SalNumberToStrX( nRowcountUt, 0 )
.head 8 +  While nIndex < nRowcountUt
.head 9 -  ! ----------Initierar tabellrader
.head 9 -  Set nRow = SalTblInsertRow( hWndTbl, TBL_MaxRow )
.head 9 -  Call SalTblSetContext ( hWndTbl, nRow )
.head 9 -  Set hWndTbl.colsLink 		= SalStrTrimX( sLinkUt[nIndex] )
.head 9 -  Set hWndTbl.colnLimit 		= nLimitUt[nIndex]
.head 9 -  Set hWndTbl.colnContentproc	= nContentprocUt[nIndex]
.head 9 -  Set hWndTbl.colnTotal 		= nTotalUt[nIndex]
.head 9 -  Set hWndTbl.colnContent 		= nContentUt[nIndex]
.head 9 -  Set hWndTbl.colnFree 		= nFreeUt[nIndex]
.head 9 -  Set hWndTbl.colnPlannedplus 	= nPlannedplusUt[nIndex]
.head 9 -  Set hWndTbl.colnPlanedminus 	= nPlannedminusUt[nIndex]
.head 9 -  Set hWndTbl.colnReservedplus	= nReservedplusUt[nIndex]
.head 9 -  ! Set hWndTbl.colnReservedminus	= nReservedminusUt[nIndex]
.head 9 -  ! Dolda
.head 9 -  Set hWndTbl.colnAnalysidnr		= nAnalysidnrUt[nIndex]
.head 9 -  Set hWndTbl.colnAnodnr 		= nAnodnrUt[nIndex]
.head 9 -  Set hWndTbl.colnBnodnr 		= nBnodnrUt[nIndex]
.head 9 -  !
.head 9 +  If colnContentproc > colnLimit
.head 10 -  Call SalTblSetCellTextColor( hWndForm.colsLink, COLOR_Red, 0 )
.head 9 -  !
.head 9 +  If nIndex <= ( nLastVisibleRow +1 )
.head 10 -  Call SalUpdateWindow( hWndForm )
.head 10 -  Call SalTblSetFlagsAnyRows( hWndTbl, ROW_New, False, 0, 0 )
.head 9 -  Set nIndex = nIndex + 1
.head 9 -  !
.head 9 +  If nRetcode != 0
.head 10 -  Call fVisaMeddelande( Msg_Fel_Ok, '', nRetcode )
.head 10 -  Set bOk = False
.head 8 +  If nRetcode != 0
.head 9 -  Call fVisaMeddelande( Msg_Fel_Ok, fGetMessageFromSqlretcode( sQualifiedOraProcedure, nRetcode ), nRetcode )
.head 9 -  Set bOk = False
.head 7 +  Else
.head 8 -  Call fVisaMeddelande( Msg_Fel_Ok, fGetMessageFromSqlretcode( sQualifiedOraProcedure, nRetcode ), nRetcode )
.head 8 -  Set bOk = False
.head 7 -  !
.head 7 -  !
.head 7 -  Call SalTblSetColumnTitle( hWndForm.colnTotal, 'Total' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 4, 0, 0 ), 0 ) || ')' )
.head 7 -  Call SalTblSetColumnTitle( hWndForm.colnContent, 'Content' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 5, 0, 0 ), 0 ) || ')' )
.head 7 -  Call SalTblSetColumnTitle( hWndForm.colnFree, 'Free' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 7, 0, 0 ), 0 ) || ')' )
.head 7 -  Call SalTblSetColumnTitle( hWndForm.colnPlannedplus, 'Planned +' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 8, 0, 0 ), 0 ) || ')' )
.head 7 -  Call SalTblSetColumnTitle( hWndForm.colnPlanedminus, 'Planned -' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 9, 0, 0 ), 0 ) || ')' )
.head 7 -  Call SalTblSetColumnTitle( hWndForm.colnReservedplus, 'Reserved' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 6, 0, 0 ), 0 ) || ')' )
.head 7 -  ! Call SalTblSetColumnTitle( hWndForm.colnReservedminus, 'Reserved -' || SalNumberToChar(13) ||  ' (' || SalNumberToStrX( SalTblColumnSum( hWndForm, 10, 0, 0 ), 0 ) || ')' )
.head 7 -  Call SalSendMsgToChildren( hWndForm, PAM_AutoSize, wParam, lParam )
.head 7 -  !
.head 7 -  Call SalTblSetFlagsAnyRows( hWndTbl, ROW_New, False, 0, 0 )
.head 7 -  !
.head 7 -  Call SalWaitCursor( False )
.head 7 -  Return bOk
.head 7 -  Break
.head 6 +  Case 2	! read ( Link )
.head 7 -  ! ----------Initiering av parametrar
.head 7 -  ! --------------- Databasanrop
.head 7 -  Set sOraPackage = 'icp_netanalysis'
.head 7 -  Set sOraProcedure = 'readLink'
.head 7 -  Set sQualifiedOraProcedure = sOraPackage||'.'||sOraProcedure
.head 7 -  !
.head 7 -  ! Set sAsignIn	= SalStrTrimX( hWndForm.sAsignUrval )
.head 7 -  ! Set sAntypIn	= SalStrTrimX( hWndForm.sAntypUrval )
