.head 7 +  ! Case 6			! A1xB6	Otillåten kombination
.head 8 +   If hWndForm.dfsSignUtrPlac 		= ''
And hWndForm.dfsNtypUtrPlac 	= ''
And hWndForm.dfsNtypBetUtrPlac 	= ''
