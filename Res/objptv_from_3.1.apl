.head 4 +  Returns
.head 5 -  Boolean:
.head 4 -  Parameters
.head 4 -  Static Variables
.head 4 +  Local variables
.head 5 -  Boolean: bOk
.head 4 +  Actions
.head 5 -  Call SalWaitCursor( True )
.head 5 -  !
.head 5 -  ! --------------- Initierar lokala variabler
.head 5 -  Set bOk = False
.head 5 -  !
.head 5 -  !
.head 5 -  ! --------------- Kontrollerar fˆnsterkomponenternas samband
.head 5 -  !
.head 5 -  ! Urvalskombinationer - From All STP 
.head 5 +  If hWndForm.cmbFromSTP		= ''
.head 6 -  !
.head 6 -  ! Urvalskombination 1 - From All STP To
.head 6 +  If hWndForm.cmbToCountryAbbr	!= '' 
Or hWndForm.cmbToCountry 		!= '' 
Or hWndForm.cmbToOperator 	!= '' 
Or hWndForm.cmbToSiteCode	!= ''  
Or hWndForm.cmbToSiteType	!= '' 
Or hWndForm.cmbToSiteTypeNo	!= '' 
Or hWndForm.dfnToSpcN		!= NUMBER_Null 
Or hWndForm.dfnToSpcU		!= NUMBER_Null  
Or hWndForm.dfnToSpcM		!= NUMBER_Null 
Or hWndForm.dfnToSpcNi 		!= NUMBER_Null  
Or hWndForm.dfnToSpcDec 		!= NUMBER_Null 
Or hWndForm.dfnFom 		!= NUMBER_Null   
Or hWndForm.dfnTom 		!= NUMBER_Null  
Or hWndForm.cmbStatus 		!= ''
.head 7 -  Set bOk = True
.head 7 -  Set hWndForm.nUrvalsKombination = 1
.head 6 -  !
.head 6 -  ! Urvalskombination 2 - From All STP Via MTP routing
.head 6 +  Else If ( hWndForm.cmbViaSiteCode 	!= '' 
Or hWndForm.cmbViaSiteType 	!= '' 
Or hWndForm.cmbViaSiteTypeNo 	!= '' )
       Or
( hWndForm.dfnViaSpcN 		!= NUMBER_Null  
Or hWndForm.dfnViaSpcU 		!= NUMBER_Null  
Or hWndForm.dfnViaSpcM 		!= NUMBER_Null 
Or hWndForm.dfnViaSpcNi		!= NUMBER_Null  
Or hWndForm.dfnViaSpcDec 		!= NUMBER_Null  )
.head 7 -  Set bOk = True
.head 7 -  Set hWndForm.nUrvalsKombination = 2
.head 5 -  !
.head 5 -  ! Urvalskombinationer - From Selected STP 
.head 5 +  Else
.head 6 -  !
.head 6 -  ! Urvalskombination 3 - From Selected STP To
.head 6 +  If hWndForm.cmbToCountryAbbr	!= '' 
Or hWndForm.cmbToCountry		!= '' 
Or hWndForm.cmbToOperator		!= '' 
Or hWndForm.cmbToSiteCode	!= ''  
Or hWndForm.cmbToSiteType	!= '' 
Or hWndForm.cmbToSiteTypeNo	!= '' 
Or hWndForm.dfnToSpcN		!= NUMBER_Null
Or hWndForm.dfnToSpcU		!= NUMBER_Null
Or hWndForm.dfnToSpcM		!= NUMBER_Null
Or hWndForm.dfnToSpcNi		!= NUMBER_Null 
Or hWndForm.dfnToSpcDec		!= NUMBER_Null 
Or hWndForm.dfnFom		!= NUMBER_Null
Or hWndForm.dfnTom		!= NUMBER_Null
Or hWndForm.cmbStatus 		!= ''
.head 7 -  Set bOk = True
.head 7 -  Set hWndForm.nUrvalsKombination = 1
.head 6 -  !
.head 6 -  ! Urvalskombination 4 - From Selected STP Via MTP routing
.head 6 +  Else If (  hWndForm.cmbViaSiteCode	!= ''  
Or hWndForm.cmbViaSiteType	!= '' 
Or hWndForm.cmbViaSiteTypeNo	!= '' )
       Or
( hWndForm.dfnViaSpcN		!= NUMBER_Null 
Or hWndForm.dfnViaSpcU		!= NUMBER_Null 
Or hWndForm.dfnViaSpcM		!= NUMBER_Null 
Or hWndForm.dfnViaSpcNi		!= NUMBER_Null 
Or hWndForm.dfnViaSpcDec		!= NUMBER_Null  )
.head 7 -  Set bOk = True
.head 7 -  Set hWndForm.nUrvalsKombination = 2
.head 6 -  !
.head 6 -  ! Urvalskombination 5 - From Selected STP and nothing more
.head 6 +  Else
.head 7 -  Set bOk = True
.head 7 -  Set hWndForm.nUrvalsKombination = 1
.head 5 -  !
.head 5 +  If bOk = False
.head 6 -  Call fVisaMeddelande( Msg_Validering_Ok, '', MsgNr_Gen4 )
.head 5 +  Else
.head 6 +  If hWndForm.nUrvalsKombination = 1 And
hWndForm.dfnToSpcDec != NUMBER_Null And hWndForm.dfnToSpcNi = NUMBER_Null
.head 7 +  If SalMessageBox ( 
'NI has not been specified, 
Continue anyway OK 
or 
Return to selection window Cancel',
MsgRubrik_FrÂga, MB_OkCancel ) = IDCANCEL
.head 8 -  Set bOk = False
.head 6 +  Else If hWndForm.nUrvalsKombination = 2 And
hWndForm.dfnViaSpcDec != NUMBER_Null And hWndForm.dfnViaSpcNi = NUMBER_Null
.head 7 +  If SalMessageBox ( 
'NI has not been specified, 
Continue anyway OK 
or 
Return to selection window Cancel',
MsgRubrik_FrÂga, MB_OkCancel ) = IDCANCEL
.head 8 -  Set bOk = False
.head 5 -  !
.head 5 -  Call SalWaitCursor( False )
.head 5 -  Return bOk
