.head 8 -  !
.head 8 +  If nRetcode = 0
.head 9 -  ! Set sOraPackage = 'icp_site'
.head 9 -  ! Set sOraProcedure = 'Close_trans'
.head 9 -  ! Set sQualifiedOraProcedure = sOraPackage||'.'||sOraProcedure
.head 9 -  ! Set sPlSqlString = sQualifiedOraProcedure||'( '
