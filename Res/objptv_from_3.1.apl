.head 2 +  Message Actions
.head 3 +  On SAM_Create
.head 4 -  Call SalGetItemName( hWndForm, sWindowName )
.head 4 -  Set sObject = 'Update SCCP data'
.head 4 -  Call SalSendClassMessage( SAM_Create, wParam, lParam )
.head 4 -  Set hWndForm.sTitle = sObject
.head 4 -  Call SalSetWindowText( hWndForm, hWndForm.sTitle )
.head 4 -  !
.head 4 -  Call fFill_SCCPU( 'COUNTRYABBR', hWndForm.cmbCountryAbbr )
.head 4 -  Call fFill_SCCPU( 'COUNTRY', hWndForm.cmbCountry )
.head 4 -  Call fFill_SCCPU( 'COUNTRYCODE', hWndForm.cmbCountryCode )
.head 4 -  Call fFill_SCCPU( 'OPERATOR', hWndForm.cmbOperator )
.head 4 -  Call fFill_SiteCode1( )
.head 4 -  Call fFill_SiteCode2( )
.head 4 -  Call SalListAdd( hWndForm.cmbStatus, '' )
.head 4 -  Call SalListAdd( hWndForm.cmbStatus, 'Planned new' )
.head 4 -  Call SalListAdd( hWndForm.cmbStatus, 'In Service' )
.head 4 -  Call SalListAdd( hWndForm.cmbStatus, 'To be removed' )
.head 4 -  !
.head 4 +  If PnSCCPnr = NUMBER_Null
.head 5 -  Call SalSendMsg( hWndForm, PAM_NewObject, wParam, lParam )
.head 4 +  Else If PnSCCPnr != NUMBER_Null
.head 5 -  Call SalSendMsg( hWndForm, PAM_ExcistingObject, wParam, lParam )
.head 4 -  Set hWndForm.bAnyWindowFieldEdited = False
.head 3 +  On SAM_CreateComplete
.head 4 -  Call SalDisableWindow( hWndForm.pbSpara )
.head 3 +  On PAM_Fetch
.head 4 +  If GnDbEngine = DbEngineOracle
.head 5 -  Call fInitSCCP( )
.head 5 -  !
.head 3 +  On PAM_NewObject
.head 4 -  Set hWndForm.sTitle = 'New SCCP data without default values'
.head 4 -  Call SalSetWindowText( hWndForm, hWndForm.sTitle )
.head 4 -  !
