.head 5 -  Number: nRowcountUt
.head 5 -  Number: nRetcode
.head 5 -  String: sColnameIn
.head 5 -  String: sCountryIn
.head 5 -  String: sCountryAbbrIn
.head 5 -  String: sCountryCodeIn
.head 5 -  String: sOperatorIn
.head 5 -  String: sStatusIn
