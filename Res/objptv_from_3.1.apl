.head 4 +  Actions
.head 5 -  Call SalWaitCursor( True )
.head 5 -  !
.head 5 -  ! --------------- Initierar lokala variabler
.head 5 -  Set bOk = False
.head 5 -  Set bClearAllControls = False
.head 5 -  !
.head 5 +  If hWndForm.cmbFromSTP 		= ''
And hWndForm.cmbToCountryAbbr 	= ''
And hWndForm.cmbToCountry	= ''
And hWndForm.cmbToOperator	= ''
And hWndForm.cmbToSiteCode	= ''
And hWndForm.cmbToSiteType 	= ''
And hWndForm.cmbToSiteTypeNo 	= ''
And hWndForm.dfnToSpcN		= NUMBER_Null
And hWndForm.dfnToSpcU		= NUMBER_Null
And hWndForm.dfnToSpcM		= NUMBER_Null
And hWndForm.dfnToSpcNi		= NUMBER_Null
And hWndForm.dfnToSpcDec	= NUMBER_Null
And hWndForm.dfnFom		= NUMBER_Null
And hWndForm.dfnTom		= NUMBER_Null
And hWndForm.cmbStatus	 	= ''
And hWndForm.cbFirstChoice		= False
And hWndForm.cbSecondChoice	= False
And hWndForm.cbThirdChoice	= False
And hWndForm.cmbViaSiteCode	 = ''
And hWndForm.cmbViaSiteType 	= ''
And hWndForm.cmbViaSiteTypeNo 	= ''
And hWndForm.dfnViaSpcN		= NUMBER_Null
And hWndForm.dfnViaSpcU		= NUMBER_Null
And hWndForm.dfnViaSpcM		= NUMBER_Null
And hWndForm.dfnViaSpcNi		= NUMBER_Null
And hWndForm.dfnViaSpcDec	= NUMBER_Null
.head 6 -  Set bClearAllControls = True
.head 5 +  If bClearAllControls = True
.head 6 -  Call SalSendMsgToChildren( hWndForm, PAM_EnableOrDisable, 0, lParam )
.head 5 +  Else
.head 6 -  !
.head 6 -  ! Alternativ 1	To Country / Operatˆr / Site
.head 6 -  !
.head 6 +  If hWndForm.cmbToCountry != '' Or hWndForm.cmbToCountryAbbr != '' Or hWndForm.cmbToOperator != ''
Or hWndForm.cmbToSiteCode != '' Or hWndForm.cmbToSiteType != '' Or hWndForm.cmbToSiteTypeNo != ''
Or hWndForm.dfnFom != NUMBER_Null Or hWndForm.dfnTom != NUMBER_Null Or hWndForm.cmbStatus != '' 
.head 7 -  !
.head 7 -  Set hWndForm.dfnToSpcN 		= NUMBER_Null
.head 7 -  Set hWndForm.dfnToSpcU 		= NUMBER_Null
.head 7 -  Set hWndForm.dfnToSpcM 		= NUMBER_Null
.head 7 -  Set hWndForm.dfnToSpcNi 		= NUMBER_Null
.head 7 -  Set hWndForm.dfnToSpcDec 	= NUMBER_Null
.head 7 -  !
.head 7 -  Call SalDisableWindow( hWndForm.dfnToSpcN )
.head 7 -  Call SalDisableWindow( hWndForm.dfnToSpcU )
.head 7 -  Call SalDisableWindow( hWndForm.dfnToSpcM )
.head 7 -  Call SalDisableWindow( hWndForm.dfnToSpcNi )
.head 7 -  Call SalDisableWindow( hWndForm.dfnToSpcDec )
.head 7 -  !
.head 7 -  Call SalColorSet( hWndForm.dfnToSpcN, COLOR_IndexWindow, COLOR_3DFace )
.head 7 -  Call SalColorSet( hWndForm.dfnToSpcU, COLOR_IndexWindow, COLOR_3DFace )
.head 7 -  Call SalColorSet( hWndForm.dfnToSpcM, COLOR_IndexWindow, COLOR_3DFace )
.head 7 -  Call SalColorSet( hWndForm.dfnToSpcNi, COLOR_IndexWindow, COLOR_3DFace )
.head 7 -  Call SalColorSet( hWndForm.dfnToSpcDec, COLOR_IndexWindow, COLOR_3DFace )
.head 6 -  !
.head 6 -  ! Alternativ NOT 1	Not (To Country / Operatˆr / Site) 	! 10-06-02 bortkommenterat
.head 6 -  !
.head 6 +  ! Else If hWndForm.cmbToCountry = '' And hWndForm.cmbToCountryAbbr = '' And hWndForm.cmbToOperator = ''
And hWndForm.cmbToSiteCode = '' And hWndForm.cmbToSiteType = '' And hWndForm.cmbToSiteTypeNo = ''
.head 7 -  !
.head 7 -  Set hWndForm.dfnFom 		= NUMBER_Null
.head 7 -  Set hWndForm.dfnTom 		= NUMBER_Null
.head 7 -  Set hWndForm.cmbStatus 		= ''
.head 7 -  Call SalDisableWindow( hWndForm.dfnFom )
