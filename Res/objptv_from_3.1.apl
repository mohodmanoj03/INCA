Returnerar:	bOk		True eller False.
ƒndringslogg
----------------------------------------------------------------------------------------------------------
Datum		ƒndrat av		Beskrivning
----------------------------------------------------------------------------------------------------------
=====================================================
.head 4 +  Returns 
.head 5 -  Boolean: 
.head 4 +  Parameters 
.head 5 -  Window Handle: hWndTarget
.head 4 -  Static Variables 
.head 4 +  Local variables 
.head 5 -  Boolean: bOk
.head 5 -  Number: nIndex
.head 5 -  String: sUtrtypfunk[*]
.head 5 -  String: sFunkbeskr[*]
.head 5 -  Number: nRowcount
.head 5 -  Number: nRetcode
.head 5 -  String: sOraPackage
.head 5 -  String: sOraProcedure
.head 5 -  String: sQualifiedOraProcedure
.head 5 -  String: sPlSqlString
.head 4 +  Actions 
.head 5 -  Call SalWaitCursor( True )
.head 5 -  !
.head 5 -  !
.head 5 -  ! --------------- Initierar lokala variabler
.head 5 -  Set bOk = True
.head 5 -  !
.head 5 -  !
.head 5 -  ! --------------- Initierar mottagande Combobox
.head 5 -  ! Kolla om den globala utrtypfunkarrayen ‰r initierad (Index 0 innehÂller antal utrtypfunker). I sÂfall
.head 5 -  ! ska de initieras i mottagande combobox.
.head 5 -  ! Om utrtypfunkarrayen inte ‰r initierad, ska en Oracleprocedur exekveras, och arrayen ska initieras,
.head 5 -  ! d‰refter ska comboboxen initieras.
.head 5 -  !
.head 5 -  ! Den globala arrayen heter: gsUtrtypfunktion
.head 5 -  !
.head 5 +  If gsUtrtypfunktion[0] != ''
.head 6 -  Set nIndex = 1
.head 6 +  While nIndex <= SalStrToNumber( gsUtrtypfunktion[0] ) 
.head 7 -  Call SalListAdd( hWndTarget, gsUtrtypfunktion[nIndex] )
.head 7 -  Set nIndex = nIndex + 1
.head 5 +  Else 
.head 6 -  ! --------------- Databasanrop
.head 6 -  Set sOraPackage = 'lna_knut_utrtyp'
.head 6 -  Set sOraProcedure = 'sel_all_utrtypfunk'
.head 6 -  Set sQualifiedOraProcedure = sOraPackage||'.'||sOraProcedure
.head 6 -  Set sPlSqlString = sQualifiedOraProcedure||'( '
.head 6 -  Set sPlSqlString = sPlSqlString || 'sUtrtypfunk,'
.head 6 -  Set sPlSqlString = sPlSqlString || 'sFunkbeskr,' 
.head 6 -  Set sPlSqlString = sPlSqlString || 'nRowcount,'
.head 6 -  Set sPlSqlString = sPlSqlString || 'nRetcode )'
.head 6 -  !
.head 6 -  Set nIndex = 0
.head 6 +  If SqlPLSQLCommand( hSqlOra1, sPlSqlString )
.head 7 +  While nIndex < nRowcount
.head 8 -  ! ----------Initierar array
.head 8 -  Set gsUtrtypfunktion[ nIndex+1 ] = SalStrTrimX( sUtrtypfunk[ nIndex ] )
.head 8 -  !
.head 8 -  Set nIndex = nIndex + 1
.head 7 -  Set gsUtrtypfunktion[ 0 ] =  SalNumberToStrX( nIndex, 0 )
.head 7 +  If gsUtrtypfunktion[0] != ''
.head 8 -  Set nIndex = 1
.head 8 +  While nIndex <= SalStrToNumber( gsUtrtypfunktion[0] ) 
.head 9 -  Call SalListAdd( hWndTarget, gsUtrtypfunktion[nIndex] )
.head 9 -  Set nIndex = nIndex + 1
.head 6 +  Else 
.head 7 -  Call fVisaMeddelande( Msg_Fel_Ok, fGetMessageFromSqlretcode( sQualifiedOraProcedure, nRetcode ), nRetcode )
.head 6 -  !
.head 6 -  !
.head 6 -  Call SalWaitCursor( False )
.head 6 -  Return bOk
.head 5 -  !
.head 5 -  Call SalWaitCursor( False )
.head 5 -  Return bOk
