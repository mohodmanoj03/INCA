.head 8 -  !
.head 8 -  Set nIndex = nIndex + 1
.head 7 -  Set gsFabrikat[ 0 ] =  SalNumberToStrX( nIndex, 0 )
.head 7 +  If gsFabrikat[0] != ''
.head 8 -  Set nIndex = 1
.head 8 +  While nIndex <= SalStrToNumber( gsFabrikat[0] ) 
.head 9 -  Call SalListAdd( hWndTarget, gsFabrikat[nIndex] )
.head 9 -  Set nIndex = nIndex + 1
.head 6 +  Else 
.head 7 -  Call fVisaMeddelande( Msg_Fel_Ok, fGetMessageFromSqlretcode( sQualifiedOraProcedure, nRetcode ), nRetcode )
.head 6 -  !
.head 6 -  !
.head 6 -  Call SalWaitCursor( False )
.head 6 -  Return bOk
