.head 4 +  Actions
.head 5 -  Call SalWaitCursor( True )
.head 5 -  Set bOk = True
.head 5 -  !
.head 5 -  !
.head 5 -  Call SalListClear( hWndTarget )
.head 5 -  ! ! --------------- Initierar lokala variabler
.head 5 -  Set sColnameIn 		= SalStrTrimX(sColumn)
.head 5 -  Set sCountryIn 		= SalStrTrimX(hWndForm.cmbCountry )
.head 5 -  Set sCountryAbbrIn 		= SalStrTrimX(hWndForm.cmbCountryAbbr )
.head 5 -  Set sCountryCodeIn 	= SalStrTrimX(hWndForm.cmbCountryCode )
.head 5 -  Set sOperatorIn 		= SalStrTrimX(hWndForm.cmbOperator)
.head 5 -  Set nIMSIcodeIn 		= SalStrToNumber( hWndForm.cmbIMSIcode )
.head 5 +  If nIMSIcodeIn = 0
.head 6 -  Set nIMSIcodeIn 		= NUMBER_Null
.head 5 -  Set sNP1In 		= SalStrTrimX(hWndForm.dfsNP1 )
.head 5 -  Set nNP7In 		= SalStrToNumber( hWndForm.cmbNP7 )
.head 5 +  If nNP7In = 0
.head 6 -  Set nNP7In 		= NUMBER_Null
.head 5 -  Set nFomIn 		= hWndForm.dfnFom
.head 5 +  If nFomIn = 0
.head 6 -  Set nFomIn 		= NUMBER_Null
.head 5 -  Set nTomIn 		= hWndForm.dfnTom
.head 5 +  If nTomIn = 0
.head 6 -  Set nTomIn 		= NUMBER_Null
.head 5 +  If SalStrTrimX(hWndForm.cmbStatus) = 'Planned new'
.head 6 -  Set sStatusIn = 'P'
.head 5 +  Else If SalStrTrimX(hWndForm.cmbStatus) = 'In Service'
.head 6 -  Set sStatusIn = 'I'
.head 5 +  Else If SalStrTrimX(hWndForm.cmbStatus) = 'To be removed'
.head 6 -  Set sStatusIn = 'T'
.head 5 +  Else
.head 6 -  Set sStatusIn = ''
.head 5 -  !
.head 5 -  ! --------------- Databasanrop
.head 5 -  !
.head 5 -  Set sOraPackage = 'icp_sccp_s'
.head 5 -  Set sOraProcedure = 'sccp1_dd_g'
.head 5 -  Set sQualifiedOraProcedure = sOraPackage||'.'||sOraProcedure
.head 5 -  Set sPlSqlString = sQualifiedOraProcedure||'( '
.head 5 -  Set sPlSqlString = sPlSqlString || 'sColnameIn,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'sValtypeUt,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'sCharArrUt,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nNumArrUt,'
.head 5 -  Set sPlSqlString = sPlSqlString || 'nRowcountUt,'
